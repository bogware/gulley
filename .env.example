# ---------------------------------------------------------------------------
# Gulley — local development environment
# Copy to .env (gitignored). NEVER put real provider keys here in a shared repo;
# in deployed environments, credentials resolve from AWS Secrets Manager by ARN.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Data plane (gateway) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- Control plane (API) ---
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8081

# --- Postgres (Aurora Serverless v2 in prod; local docker-compose here) ---
DATABASE_URL=postgres://gulley:gulley@localhost:5432/gulley

# --- Redis, split by role (separate clusters in prod; separate ports locally) ---
REDIS_CACHE_URL=redis://localhost:6379
REDIS_COUNTERS_URL=redis://localhost:6380
REDIS_VECTOR_URL=redis://localhost:6381

# --- Gateway data plane (M1) ---
# Pepper used to HMAC virtual keys. KMS-held in prod; any strong random string in dev.
GULLEY_KEY_PEPPER=dev-only-change-me
# Upstream Anthropic credential the gateway holds centrally (v1).
ANTHROPIC_UPSTREAM_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Custom / OpenAI-compatible providers (hosted presets + local models) ---
# JSON array. Preset-backed (hosted): {"preset":"groq","apiKey":"...","models":["llama-3.3-70b"]}.
# Local runtimes are keyless — Ollama/Jan/LM Studio/vLLM/LocalAI/llama.cpp:
#   CUSTOM_PROVIDERS=[{"preset":"ollama","models":["llama3.1","qwen2.5-coder"]}]
# Each provider is reachable at /{provider}/v1/chat/completions; declared models
# also route on the shared /v1/chat/completions and appear in GET /v1/models.
CUSTOM_PROVIDERS=

# --- CEL policy: authorization + transformation (over { request, principal }) ---
# Authz rules (deny-first, then allow-list). Example:
# CEL_AUTHZ=[{"effect":"deny","name":"no-experimental","expr":"request.model.startsWith(\"experimental-\")"}]
CEL_AUTHZ=
# Header/body transforms. Example:
# CEL_TRANSFORM={"requestBody":[{"field":"max_tokens","value":"512"}],"responseHeaders":[{"name":"X-Policy","value":"\"applied\""}]}
CEL_TRANSFORM=

# --- Identity (Microsoft Entra ID / OIDC) — fill for control-plane SSO ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Admin console OIDC session gate (control-api; generic, discovery-based) ---
# Set OIDC_ISSUER + OIDC_CLIENT_ID to enable "Sign in with SSO". Group→role via
# OIDC_ROLE_MAP (JSON [{group,role,orgId}]; orgId "*" = all orgs). Requires
# GULLEY_ADMIN_SESSION_SECRET (>=32 chars) to sign the session.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/control/auth/callback
# OIDC_ROLE_MAP=[{"group":"gulley-admins","role":"owner","orgId":"*"}]
# OIDC_COOKIE_SECURE=false  # set true behind HTTPS
GULLEY_ADMIN_SESSION_SECRET=

# --- Rate limiting (RPM/TPM) ---
# Per-workspace rules live in the rate_limit table; no rows = no limiting.
# Global (cross-replica) counters reuse REDIS_COUNTERS_URL; without it, limits
# are per-replica (in-memory). fail-open admits when the limiter backend errors.
RATELIMIT_ENABLED=true
RATELIMIT_FAIL_OPEN=true

# --- Resilience: bounded same-target retry (pre-first-byte body replay) ---
# 1 = no retry (default). >1 retries the same target on transient errors before
# failing over, with exponential backoff floored by any upstream Retry-After.
RETRY_MAX_ATTEMPTS=1
RETRY_BACKOFF_MS=250

# --- Load balancing (loadbalance strategy targets) ---
# LB_LEAST_LOAD: power-of-two-choices least-load for the primary pick (default on).
# LB_SESSION_AFFINITY_HEADER: pin a session to one target (HRW) by this header's
# value (else the principal id); unset = no affinity.
LB_LEAST_LOAD=true
# LB_SESSION_AFFINITY_HEADER=x-session-id

# --- Inbound auth beyond virtual keys (data plane) ---
# JWT/JWKS: clients present their IdP's JWT. Enable with JWT_ISSUER + JWT_AUDIENCE.
# Scope comes from claims (falling back to the JWT_DEFAULT_* below).
# JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# JWT_AUDIENCE=api://gulley
# JWT_WORKSPACE_CLAIM=gulley_workspace
# JWT_ORG_CLAIM=gulley_org
# JWT_MODELS_CLAIM=gulley_models
# JWT_PROVIDERS_CLAIM=gulley_providers
# JWT_DEFAULT_WORKSPACE_ID=
# JWT_DEFAULT_ORG_ID=
#
# HTTP Basic (htpasswd-backed: bcrypt/apr1/SHA/plaintext). Enable with an htpasswd
# source plus the default org/workspace. Per-user scope overrides via a JSON object.
# BASIC_AUTH_HTPASSWD_FILE=/etc/gulley/htpasswd
# BASIC_AUTH_HTPASSWD=alice:$apr1$...   # inline alternative to the file
# BASIC_AUTH_USER_SCOPES={"alice":{"workspaceId":"ws_a","allowedModels":["claude-sonnet-4-6"]}}
# BASIC_AUTH_DEFAULT_ORG_ID=org_1
# BASIC_AUTH_DEFAULT_WORKSPACE_ID=ws_default

# --- Optional bring-your-own-DLP webhook guardrail (runs on request input) ---
# A block/mask verdict is authoritative even under the audit-only default.
# GUARDRAILS_WEBHOOK_URL=https://dlp.internal/scan
GUARDRAILS_WEBHOOK_FAIL_CLOSED=false
GUARDRAILS_WEBHOOK_ALLOW_INTERNAL=false

# --- Optional managed guardrail plugins (composed with the native detectors) ---
# OpenAI Moderation:
# GUARDRAILS_MODERATION_API_KEY=
# Azure AI Content Safety (blocks at/above the severity threshold, 0-7):
# GUARDRAILS_AZURE_CS_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# GUARDRAILS_AZURE_CS_KEY=
# GUARDRAILS_AZURE_CS_SEVERITY=4
# Google Cloud Model Armor (needs a refreshed GCP OAuth2 access token):
# GUARDRAILS_MODEL_ARMOR_PROJECT=
# GUARDRAILS_MODEL_ARMOR_LOCATION=us-central1
# GUARDRAILS_MODEL_ARMOR_TEMPLATE=
# GUARDRAILS_MODEL_ARMOR_ACCESS_TOKEN=

# --- Model cost catalog (operator-maintained JSON; regenerate via catalog:refresh) ---
# MODELS_CATALOG_FILE=./models.catalog.json

# --- Request-log batching (operational log off the hot path) ---
LOG_BATCH_MAX=100
LOG_BATCH_INTERVAL_MS=1000

# --- Telemetry (OpenTelemetry export to your external backend) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gulley-gateway
# Prometheus /metrics on a separate management listener (not the data port).
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_HOST=0.0.0.0
# Content/credential logging is OFF by default; never enable in shared envs.
GULLEY_LOG_CONTENT=false
