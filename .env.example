# ---------------------------------------------------------------------------
# Gulley — local development environment
# Copy to .env (gitignored). NEVER put real provider keys here in a shared repo;
# in deployed environments, credentials resolve from AWS Secrets Manager by ARN.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- Data plane (gateway) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Max inbound request body. Fastify defaults to 1 MiB, which 413s real coding-agent
# requests (long-context repomaps, base64 images). 32 MiB default.
MAX_REQUEST_BYTES=33554432
# Proxy trust for X-Forwarded-For / client IP: "true"/"false", a hop COUNT (e.g. "1"
# to trust one proxy like an ALB), or a trusted CIDR / comma-separated list. A bare
# "true" lets X-Forwarded-For spoof request.ip — set a hop count/CIDR if you use a
# CEL source-IP rule.
TRUST_PROXY=true

# --- Control plane (API) ---
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=8081
# Compliance: HMAC key that signs auditor attestations (GET /audit/attestation and
# the `audit:verify` CLI). Unset = attestation export disabled (501). The auditor
# holds the same key to verify the signature independently. >=16 chars.
# AUDIT_ATTESTATION_KEY=
# AUDIT_ATTESTATION_SUBJECT=prod-us-east-1
# Mask-vault reveal (M22 D, control-api): serve GET /admin/mask-vault/:requestId to
# decrypt the token↔original map for a masked request. Needs the SAME envelope key the
# gateway used — set GULLEY_KMS_KEY_ARN in prod. Unset ⇒ 501.
MASK_VAULT_ENABLED=false
# GULLEY_KMS_REGION=us-east-1
# Gateway PUBLIC base URL, used to generate turnkey client configs
# (GET /admin/workspaces/:id/client-config for Claude Code / Codex). Unset ⇒ 501.
# GATEWAY_PUBLIC_URL=https://gulley.acme.internal
# Ed25519 private key (PEM) that SIGNS onboarding packs (GET .../onboarding-pack). The
# org publishes the matching public key at /.well-known/gulley-onboarding-key so
# `gulley init` verifies a pack before writing any config (tamper-evident onboarding).
# Generate: openssl genpkey -algorithm ed25519. Unset ⇒ the pack endpoint 501s.
# ONBOARDING_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Shadow-spend reconciliation (control-api, "CISO bypass alert"): org-level ADMIN keys
# for the providers' own usage/cost APIs. When set, GET /admin/analytics/shadow-spend
# reconciles each provider's billed spend against the gateway ledger to surface spend
# that bypassed Gulley (a provider key used directly). Absent for a provider ⇒
# gateway-only (can't be flagged). Requires a DATABASE_URL (the ledger baseline).
# ANTHROPIC_ADMIN_API_KEY=
# OPENAI_ADMIN_API_KEY=
# Flag a provider whose bypassed share of billed spend is at/above this many basis
# points (500 = 5%).
SHADOW_SPEND_FLAG_BPS=500

# --- Postgres (Aurora Serverless v2 in prod; local docker-compose here) ---
DATABASE_URL=postgres://gulley:gulley@localhost:5432/gulley

# --- Redis, split by role (separate clusters in prod; separate ports locally) ---
REDIS_CACHE_URL=redis://localhost:6379
REDIS_COUNTERS_URL=redis://localhost:6380
REDIS_VECTOR_URL=redis://localhost:6381

# --- FinOps: budget alerts + budget-aware routing (M20) ---
# Soft-threshold alerts before the hard 402 (metric always; webhook if set).
# BUDGET_ALERT_WEBHOOK_URL=https://hooks.example.com/budget
BUDGET_ALERT_THRESHOLDS=0.8,0.9
# Budget-aware downshift: at/above this utilization, rewrite the request model to
# BUDGET_DOWNSHIFT_MODEL (a cheaper model the route can serve). 0 = off.
BUDGET_DOWNSHIFT_THRESHOLD=0
# BUDGET_DOWNSHIFT_MODEL=claude-haiku-4-5
# Per-model budget caps (multi-level enforcement: workspace AND model caps must both
# admit). JSON map of model id → { capMicroUsd, periodSeconds? }. Needs Redis counters
# for cross-process enforcement; the in-memory store enforces single-node.
# BUDGET_MODEL_CAPS={"claude-opus-4-8":{"capMicroUsd":10000000,"periodSeconds":86400}}
# Per-attribution budget caps (runaway-agent control): a cap keyed by an attribution
# dimension (from ATTRIBUTION_HEADERS) enforced in addition to the workspace/model caps,
# so a looping autonomous session or a heavy developer hits its OWN cap. Enforced with
# or without Redis counters. JSON map of attribution key → { capMicroUsd, periodSeconds? };
# periodSeconds is ALWAYS applied (defaults to 86400/24h) since the key value is
# client-supplied — a rolling window keeps the noeviction counters store bounded.
# BUDGET_ATTR_CAPS={"session":{"capMicroUsd":5000000,"periodSeconds":86400},"dev":{"capMicroUsd":50000000,"periodSeconds":86400}}
# Cost-attribution headers captured onto ledger/request-log/audit (x-gulley-/x- stripped):
# ATTRIBUTION_HEADERS=x-gulley-session,x-gulley-repo,x-gulley-branch,x-gulley-dev

# Playground preflight (POST /v1/playground/verify): first-run "does my key/route
# work?" check — authz/route/guardrail/cost/budget with NO upstream call or spend.
PLAYGROUND_ENABLED=true

# --- Gateway data plane (M1) ---
# Pepper used to HMAC virtual keys. KMS-held in prod; any strong random string in dev.
GULLEY_KEY_PEPPER=dev-only-change-me
# Upstream Anthropic credential the gateway holds centrally (v1).
ANTHROPIC_UPSTREAM_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Custom / OpenAI-compatible providers (hosted presets + local models) ---
# JSON array. Preset-backed (hosted): {"preset":"groq","apiKey":"...","models":["llama-3.3-70b"]}.
# Local runtimes are keyless — Ollama/Jan/LM Studio/vLLM/LocalAI/llama.cpp:
#   CUSTOM_PROVIDERS=[{"preset":"ollama","models":["llama3.1","qwen2.5-coder"]}]
# Each provider is reachable at /{provider}/v1/chat/completions; declared models
# also route on the shared /v1/chat/completions and appear in GET /v1/models.
CUSTOM_PROVIDERS=

# Central model allow/deny policy (deployment-wide), enforced at authz on the resolved
# model + reflected in GET /v1/models. Comma-separated model patterns (`*` glob),
# deny-first. In DB config mode the config document's `policies` entities take over.
# MODEL_ALLOW=claude-*,gpt-4o-*
# MODEL_DENY=*-experimental
MODEL_ALLOW=
MODEL_DENY=

# --- CEL policy: authorization + transformation (over { request, principal }) ---
# Authz rules (deny-first, then allow-list). Example:
# CEL_AUTHZ=[{"effect":"deny","name":"no-experimental","expr":"request.model.startsWith(\"experimental-\")"}]
CEL_AUTHZ=
# Header/body transforms. Example:
# CEL_TRANSFORM={"requestBody":[{"field":"max_tokens","value":"512"}],"responseHeaders":[{"name":"X-Policy","value":"\"applied\""}]}
CEL_TRANSFORM=
# LLM-leg tool-call intent governance (no MCP proxy): a JSON array of CEL rules (same
# shape as CEL_AUTHZ) evaluated against each tool call the MODEL requests in its
# response, over { tool: { name, input }, model, provider, principal }. Deny-first; a
# match withholds the whole response fail-closed. Governs BOTH streamed and non-
# streamed responses (streamed responses are buffered + reassembled so stream:true
# cannot bypass governance — this trades streaming latency for governance).
# TOOL_POLICY=[{"effect":"deny","name":"no-rm","expr":"tool.name==\"shell\" && tool.input.command.contains(\"rm -rf\")"}]
TOOL_POLICY=

# --- External authorization hook (delegate allow/deny to a policy service) ---
# The { request, principal } activation is POSTed; { allow, reason } expected.
# Decisions are cached (TTL) + single-flighted; runs after the local CEL rules.
# EXTERNAL_AUTHZ_URL=https://policy.internal/authz
# EXTERNAL_AUTHZ_CACHE_KEY=principal.id + ":" + request.model   # CEL; default: principal+model+provider
EXTERNAL_AUTHZ_TTL_MS=30000
EXTERNAL_AUTHZ_TIMEOUT_MS=1000
EXTERNAL_AUTHZ_FAIL_OPEN=false
EXTERNAL_AUTHZ_ALLOW_INTERNAL=false
# Credential headers are NEVER sent to the policy service. The prompt body is
# omitted unless you opt in (which also makes the decision cache body-specific).
EXTERNAL_AUTHZ_SEND_BODY=false

# --- Identity (Microsoft Entra ID / OIDC) — fill for control-plane SSO ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Admin console OIDC session gate (control-api; generic, discovery-based) ---
# Set OIDC_ISSUER + OIDC_CLIENT_ID to enable "Sign in with SSO". Group→role via
# OIDC_ROLE_MAP (JSON [{group,role,orgId}]; orgId "*" = all orgs). Requires
# GULLEY_ADMIN_SESSION_SECRET (>=32 chars) to sign the session.
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/control/auth/callback
# OIDC_ROLE_MAP=[{"group":"gulley-admins","role":"owner","orgId":"*"}]
# OIDC_COOKIE_SECURE=false  # set true behind HTTPS
GULLEY_ADMIN_SESSION_SECRET=

# --- Admin surface HTTP edge (control-api) ---
# CORS is credentials-safe: exact full origins (comma-separated), reflected with
# Allow-Credentials. Leave empty for the same-origin /control proxy deployment.
# ADMIN_CORS_ORIGINS=https://admin.example.com
# CSRF gates cookie-authed unsafe methods via Sec-Fetch-Site (bearer/API clients
# and allowlisted CORS origins are exempt).
ADMIN_CSRF_ENABLED=true

# --- Rate limiting (RPM/TPM) ---
# Per-workspace rules live in the rate_limit table; no rows = no limiting.
# Global (cross-replica) counters reuse REDIS_COUNTERS_URL; without it, limits
# are per-replica (in-memory). fail-open admits when the limiter backend errors.
RATELIMIT_ENABLED=true
RATELIMIT_FAIL_OPEN=true

# --- Resilience: bounded same-target retry (pre-first-byte body replay) ---
# 1 = no retry (default). >1 retries the same target on transient errors before
# failing over, with exponential backoff floored by any upstream Retry-After.
RETRY_MAX_ATTEMPTS=1
RETRY_BACKOFF_MS=250
# Total pre-first-byte deadline (ms), measured from request entry: bounds the whole
# dispatch/failover/retry phase so a slow or serially-failing candidate set can't pin
# a request for N x the per-attempt header timeout. On breach the client gets a 504.
# 0 = off (only the post-first-byte inactivity watchdog applies).
REQUEST_DEADLINE_MS=0

# --- Passive outlier detection (peer-relative slow-target ejection) ---
# Eject a loadbalance/fallback target whose EWMA time-to-response-headers is
# >= OUTLIER_LATENCY_FACTOR x the peer baseline (and above the floor), even with
# zero errors; re-probed by time. Off by default; independent of the breaker.
OUTLIER_ENABLED=false
OUTLIER_LATENCY_FACTOR=3
OUTLIER_MIN_SAMPLES=20
OUTLIER_MIN_EJECT_MS=500
OUTLIER_BASE_EJECT_MS=30000
OUTLIER_MAX_EJECT_MS=300000

# --- Cross-replica breaker sharing (multi-task deployments) ---
# Broadcast circuit-breaker ejections through the counters Redis so a target
# ejected by one replica is honored fleet-wide (an outage costs one replica's
# failure budget, not every replica's). Requires REDIS_COUNTERS_URL. Off by
# default; per-replica breaker still applies.
BREAKER_SHARED=false
BREAKER_SHARED_PREFIX=gulley
BREAKER_SHARED_REFRESH_MS=1000

# --- Adaptive concurrency (per-target dynamic in-flight ceiling) ---
# A gradient limiter that shrinks a target's admission ceiling under rising
# latency/errors. A saturated target is skipped (load-shed, not a fault); when
# every candidate is saturated the request is shed with 503 + Retry-After.
# Off by default (no admission ceiling).
ADAPTIVE_CONCURRENCY_ENABLED=false
ADAPTIVE_MIN_LIMIT=4
ADAPTIVE_MAX_LIMIT=200
ADAPTIVE_INITIAL_LIMIT=20
ADAPTIVE_BACKOFF_RATIO=0.9
ADAPTIVE_SMOOTHING=0.2

# --- Smart routing (M15) ---
# Classify each request and reroute by category. DB config only (the
# smartRoutingPolicies collection). Off by default; when on, the reconciler
# builds the smart router from the config document.
SMART_ROUTING_ENABLED=false
# embedding-nearest-label backend (reuses the EMBEDDINGS_* provider).
SMART_ROUTING_SIMILARITY_THRESHOLD=0.6
SMART_ROUTING_EMBED_TIMEOUT_MS=1500
# Persist embedded exemplar centroids (DB config mode) so replicas reuse them
# instead of re-embedding on boot. Fail-open; keyed by EMBEDDINGS_MODEL.
SMART_ROUTING_PERSIST_CENTROIDS=true
# Serve request-time nearest-label from a pgvector ANN index (HNSW, migration 0012)
# instead of an in-memory cosine scan — scales to large exemplar sets. Requires
# SMART_ROUTING_PERSIST_CENTROIDS and pins EMBEDDINGS_DIMENSIONS=256 (the vector
# column dim); any other dim falls back to the in-memory scan.
SMART_ROUTING_CENTROID_ANN=false

# --- Multi-target routing (M19) ---
# ROUTE_GROUPS combines configured single-target provider routes into fallback /
# loadbalance routes, turning on the breaker/outlier/P2C/HRW/hedge machinery.
# ROUTE_GROUPS='[{"clientPath":"/v1/messages","mode":"fallback","providers":["anthropic","bedrock"],"onStatusCodes":[429,529]}]'
# HEDGE_DELAY_MS: global pre-first-byte hedge for multi-target routes (0 = off).
HEDGE_DELAY_MS=0

# --- Load balancing (loadbalance strategy targets) ---
# LB_LEAST_LOAD: power-of-two-choices least-load for the primary pick (default on).
# LB_SESSION_AFFINITY_HEADER: pin a session to one target (HRW) by this header's
# value (else the principal id); unset = no affinity.
LB_LEAST_LOAD=true
# LB_SESSION_AFFINITY_HEADER=x-session-id

# --- Inbound auth beyond virtual keys (data plane) ---
# JWT/JWKS: clients present their IdP's JWT. Enable with JWT_ISSUER + JWT_AUDIENCE.
# Scope comes from claims (falling back to the JWT_DEFAULT_* below).
# JWT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# JWT_AUDIENCE=api://gulley
# JWT_WORKSPACE_CLAIM=gulley_workspace
# JWT_ORG_CLAIM=gulley_org
# JWT_MODELS_CLAIM=gulley_models
# JWT_PROVIDERS_CLAIM=gulley_providers
# JWT_DEFAULT_WORKSPACE_ID=
# JWT_DEFAULT_ORG_ID=
#
# HTTP Basic (htpasswd-backed: bcrypt/apr1/SHA/plaintext). Enable with an htpasswd
# source plus the default org/workspace. Per-user scope overrides via a JSON object.
# BASIC_AUTH_HTPASSWD_FILE=/etc/gulley/htpasswd
# BASIC_AUTH_HTPASSWD=alice:$apr1$...   # inline alternative to the file
# BASIC_AUTH_USER_SCOPES={"alice":{"workspaceId":"ws_a","allowedModels":["claude-sonnet-4-6"]}}
# BASIC_AUTH_DEFAULT_ORG_ID=org_1
# BASIC_AUTH_DEFAULT_WORKSPACE_ID=ws_default

# --- Output guardrail policy ---
# audit (default) records findings only; block/mask/redact enforce. On a STREAMED
# response, enforcement is audit-only unless a route sets holdStreamedOutput
# (buffer-and-withhold) or STREAMING_ENFORCE is on (windowed in-stream redaction,
# Anthropic-canonical routes only — trades raw-byte fidelity + a bounded delay).
GUARDRAILS_OUTPUT_ACTION=audit
GUARDRAILS_OUTPUT_MIN_CONFIDENCE=0.5
# Input enforcement: `mask` reversibly tokenizes PII/secrets to the provider and
# detokenizes on the response (the reversible vault round-trip); block / redact / audit.
GUARDRAILS_INPUT_ACTION=audit
GUARDRAILS_INPUT_MIN_CONFIDENCE=0.5
# Native prompt-injection / jailbreak detector (local, no egress). Emits
# prompt_injection / jailbreak findings; block them via GUARDRAILS_INPUT_ACTION=block
# (optionally category-scoped) so PII can audit while injection blocks.
GUARDRAILS_INJECTION_ENABLED=false
# Indirect-injection spotlighting: wrap UNTRUSTED request spans (Anthropic tool_result
# blocks + OpenAI role:"tool" messages — external tool/document output) in trust-tag
# delimiters so the model treats them as data, not instructions. Deterministic +
# structure-preserving (cache-safe). GUARDRAILS_SPOTLIGHT_DIRECTIVE also prepends a
# system directive explaining the tags (higher efficacy; shifts Anthropic prompt-cache
# breakpoints, so opt in deliberately).
GUARDRAILS_SPOTLIGHT=false
GUARDRAILS_SPOTLIGHT_DIRECTIVE=false
STREAMING_ENFORCE=false
STREAMING_ENFORCE_WINDOW_CHARS=512
# Durable mask-reversal store (M22 D): persist the guardrail-mask token↔original map,
# envelope-encrypted at rest, so an authorized admin can de-tokenize a masked response
# later. Off by default; when on, set GULLEY_KMS_KEY_ARN in prod (the in-memory dev
# cipher is per-process and can't be revealed by the control-api). Secret ARNs only.
MASK_VAULT_PERSIST=false
MASK_VAULT_TTL_SECONDS=604800
# GULLEY_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/abcd-...

# --- Optional bring-your-own-DLP webhook guardrail (runs on request input) ---
# A block/mask verdict is authoritative even under the audit-only default.
# GUARDRAILS_WEBHOOK_URL=https://dlp.internal/scan
GUARDRAILS_WEBHOOK_FAIL_CLOSED=false
GUARDRAILS_WEBHOOK_ALLOW_INTERNAL=false

# --- Optional managed guardrail plugins (composed with the native detectors) ---
# OpenAI Moderation:
# GUARDRAILS_MODERATION_API_KEY=
# Azure AI Content Safety (blocks at/above the severity threshold, 0-7):
# GUARDRAILS_AZURE_CS_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# GUARDRAILS_AZURE_CS_KEY=
# GUARDRAILS_AZURE_CS_SEVERITY=4
# Google Cloud Model Armor (needs a refreshed GCP OAuth2 access token):
# GUARDRAILS_MODEL_ARMOR_PROJECT=
# GUARDRAILS_MODEL_ARMOR_LOCATION=us-central1
# GUARDRAILS_MODEL_ARMOR_TEMPLATE=
# GUARDRAILS_MODEL_ARMOR_ACCESS_TOKEN=

# --- Model cost catalog (operator-maintained JSON; regenerate via catalog:refresh) ---
# MODELS_CATALOG_FILE=./models.catalog.json

# --- Request-log batching (operational log off the hot path) ---
LOG_BATCH_MAX=100
LOG_BATCH_INTERVAL_MS=1000

# --- Access log (operator-configurable per-request fields) ---
# CEL-valued fields over a credential-free record; remove/filter/flatten.
# ACCESS_LOG_FIELDS={"add":{"cost_usd":"costMicroUsd / 1000000.0"},"filter":"statusCode >= 400"}
# Also ship each access-log record to the OTLP logs backend (/v1/logs), not just stdout.
ACCESS_LOG_OTLP=false

# --- Distributed tracing (W3C traceparent propagation) ---
# Continue a client's traceparent (or start one) and inject it upstream; stamps
# the trace id on the span + access log. Sample ratio applies to fresh traces.
TRACE_PROPAGATION=false
TRACE_SAMPLE_RATIO=1

# --- Response buffering / output-enforcement cap ---
# When a buffered-enforcement response exceeds the cap the guardrail can't see
# the whole body: fail-closed withholds it (safe default), fail-open forwards the
# truncated prefix flagged as unenforced.
RESPONSE_BUFFER_LIMIT_BYTES=8388608
BUFFER_FAIL_CLOSED=true

# --- Static header modifier (non-CEL request/response header set/remove) ---
# HEADER_MODIFIER={"request":{"set":{"x-tenant":"acme"}},"response":{"remove":["x-internal"]}}

# --- Request mirror (shadow traffic; fire-and-forget, sampled, never metered) ---
# REQUEST_MIRROR={"url":"https://shadow.internal/v1/messages","sampleRate":0.1,"headers":{"authorization":"Bearer shadow"}}
REQUEST_MIRROR_ALLOW_INTERNAL=false

# --- Live request tracer (SSE at /debug/trace; served only when a token is set) ---
# DEBUG_TRACE_TOKEN=change-me
DEBUG_TRACE_BUFFER=200

# --- M13 config hot-reload (data plane) ---
# CONFIG_SOURCE=db builds routes from the Postgres config document and reconciles
# live when the control plane broadcasts an apply (Postgres LISTEN/NOTIFY). The
# gateway resolves provider credential ARNs at reload via SECRETS_* (below).
CONFIG_SOURCE=env
CONFIG_NOTIFY_CHANNEL=gulley:config
# Steady-state convergence poll (seconds) for db config: reconciles a replica when
# the stored config version is ahead of what it applied, so the fleet converges even
# if a NOTIFY is missed. 0 = rely on NOTIFY only.
CONFIG_POLL_INTERVAL_SECONDS=30
# DATABASE_URL=postgres://gulley:gulley@localhost:5432/gulley
# Secret resolution: a local ARN→value map for dev, else AWS Secrets Manager.
# SECRETS_LOCAL_MAP={"arn:aws:secretsmanager:...:secret:anthropic":"sk-ant-..."}
# SECRETS_REGION=us-east-1

# --- Telemetry (OpenTelemetry export to your external backend) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gulley-gateway
# Prometheus /metrics on a separate management listener (not the data port).
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_HOST=0.0.0.0
# Content/credential logging is OFF by default; never enable in shared envs.
GULLEY_LOG_CONTENT=false
