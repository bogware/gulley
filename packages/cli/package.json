{
  "name": "@gulley/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Developer-side CLI for Gulley: OAuth device login + token helper for Claude Code / Codex, signed onboarding-pack verification, and the client-config generator the control plane shares.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "bin": {
    "gulley": "./bin/gulley.mjs"
  },
  "scripts": {
    "gulley": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
