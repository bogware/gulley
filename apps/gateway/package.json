{
  "name": "@gulley/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "live": "tsx src/live-check.ts",
    "live:anthropic": "tsx src/live-check.ts --provider anthropic",
    "live:openai": "tsx src/live-check.ts --provider openai",
    "live:bedrock": "tsx src/live-check.ts --provider bedrock",
    "live:azure": "tsx src/live-check.ts --provider azure",
    "live:translate": "tsx src/live-check.ts --provider translate",
    "budget:check": "tsx src/budget-check.ts",
    "otel:check": "tsx src/otel-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gulley/auth": "workspace:*",
    "@gulley/budget": "workspace:*",
    "@gulley/core": "workspace:*",
    "@gulley/cost": "workspace:*",
    "@gulley/pipeline": "workspace:*",
    "@gulley/providers": "workspace:*",
    "@gulley/routing": "workspace:*",
    "@gulley/storage": "workspace:*",
    "@gulley/telemetry": "workspace:*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
