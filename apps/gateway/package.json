{
  "name": "@gulley/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "live": "tsx --env-file-if-exists=../../.env src/live-check.ts",
    "live:anthropic": "tsx --env-file-if-exists=../../.env src/live-check.ts --provider anthropic",
    "live:openai": "tsx --env-file-if-exists=../../.env src/live-check.ts --provider openai",
    "live:bedrock": "tsx --env-file-if-exists=../../.env src/live-check.ts --provider bedrock",
    "live:azure": "tsx --env-file-if-exists=../../.env src/live-check.ts --provider azure",
    "live:translate": "tsx --env-file-if-exists=../../.env src/live-check.ts --provider translate",
    "budget:check": "tsx --env-file-if-exists=../../.env src/budget-check.ts",
    "catalog:refresh": "tsx --env-file-if-exists=../../.env src/catalog-refresh.ts",
    "otel:check": "tsx --env-file-if-exists=../../.env src/otel-check.ts",
    "cache:check": "tsx --env-file-if-exists=../../.env src/cache-check.ts",
    "guardrail:check": "tsx --env-file-if-exists=../../.env src/guardrail-check.ts",
    "bedrock-guardrail:check": "tsx --env-file-if-exists=../../.env src/bedrock-guardrail-check.ts",
    "load:check": "tsx --env-file-if-exists=../../.env src/load-check.ts",
    "smart:check": "tsx --env-file-if-exists=../../.env src/smart-check.ts",
    "doctor": "tsx --env-file-if-exists=../../.env src/doctor.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "@gulley/auth": "workspace:*",
    "@gulley/budget": "workspace:*",
    "@gulley/cache": "workspace:*",
    "@gulley/catalog": "workspace:*",
    "@gulley/cel": "workspace:*",
    "@gulley/config": "workspace:*",
    "@gulley/core": "workspace:*",
    "@gulley/cost": "workspace:*",
    "@gulley/crypto": "workspace:*",
    "@gulley/egress": "workspace:*",
    "@gulley/guardrails": "workspace:*",
    "@gulley/http-edge": "workspace:*",
    "@gulley/metrics": "workspace:*",
    "@gulley/oauth": "workspace:*",
    "@gulley/oidc": "workspace:*",
    "@gulley/pipeline": "workspace:*",
    "@gulley/providers": "workspace:*",
    "@gulley/ratelimit": "workspace:*",
    "@gulley/routing": "workspace:*",
    "@gulley/storage": "workspace:*",
    "@gulley/telemetry": "workspace:*",
    "fastify": "^5.2.0",
    "pino": "^10.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
