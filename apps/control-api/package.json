{
  "name": "@gulley/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/seed.ts",
    "rbac:check": "tsx src/rbac-check.ts",
    "oauth:check": "tsx src/oauth-check.ts",
    "typecheck": "tsc --noEmit",
