{
  "name": "@gulley/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/seed.ts",
    "rbac:check": "tsx src/rbac-check.ts",
    "oauth:check": "tsx src/oauth-check.ts",
    "config:check": "tsx src/config-check.ts",
    "config:db:check": "tsx src/config-db-check.ts",
    "worm:check": "tsx src/worm-check.ts",
    "audit:verify": "tsx src/audit-verify.ts",
    "kms:check": "tsx src/kms-check.ts",
    "ssrf:check": "tsx src/ssrf-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
