{
  "name": "@gulley/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "rbac:check": "tsx --env-file-if-exists=../../.env src/rbac-check.ts",
    "oauth:check": "tsx --env-file-if-exists=../../.env src/oauth-check.ts",
    "config:check": "tsx --env-file-if-exists=../../.env src/config-check.ts",
    "config:db:check": "tsx --env-file-if-exists=../../.env src/config-db-check.ts",
    "worm:check": "tsx --env-file-if-exists=../../.env src/worm-check.ts",
    "audit:verify": "tsx --env-file-if-exists=../../.env src/audit-verify.ts",
    "kms:check": "tsx --env-file-if-exists=../../.env src/kms-check.ts",
    "ssrf:check": "tsx --env-file-if-exists=../../.env src/ssrf-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@gulley/auth": "workspace:*",
    "@gulley/catalog": "workspace:*",
    "@gulley/cli": "workspace:*",
    "@gulley/config": "workspace:*",
    "@gulley/core": "workspace:*",
    "@gulley/cost": "workspace:*",
    "@gulley/crypto": "workspace:*",
    "@gulley/egress": "workspace:*",
    "@gulley/http-edge": "workspace:*",
    "@gulley/oauth": "workspace:*",
    "@gulley/oidc": "workspace:*",
    "@gulley/pipeline": "workspace:*",
    "@gulley/prompts": "workspace:*",
    "@gulley/rbac": "workspace:*",
    "@gulley/redact": "workspace:*",
    "@gulley/storage": "workspace:*",
    "@gulley/worm": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "pino": "^10.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
