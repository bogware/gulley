{
  "name": "gulley",
  "version": "0.0.0",
  "private": true,
  "description": "Gulley — enterprise LLM gateway",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @gulley/storage db:generate",
    "gulley": "pnpm --filter @gulley/cli gulley",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "yaml": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4",
      "postcss": ">=8.5.18",
      "fast-uri@>=4.0.0 <4.1.3": ">=4.1.4",
      "fast-uri@>=3.0.0 <3.1.6": ">=3.1.6"
    }
  }
}
